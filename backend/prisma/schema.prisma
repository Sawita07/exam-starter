// ===== schema.prisma = หน้าตาตารางในฐานข้อมูล =====
// แก้ไฟล์นี้เสร็จทุกครั้ง ให้รัน:  npx prisma db push
// (คำสั่งนี้สร้าง/อัปเดตตารางในไฟล์ dev.db ให้ตรงกับไฟล์นี้)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ตารางแม่ (1)  — ตอนสอบเปลี่ยนชื่อ/ฟิลด์ให้ตรงโจทย์ เช่น Category, Catalog
model Book {
  id            Int      @id @default(autoincrement()) // รหัส เลขรันเอง
  title         String                                 // ข้อความ บังคับกรอก
  author        String
  publishedYear Int?                                   // ? = ไม่บังคับ
  isAvailable   Boolean  @default(true)
  coverUrl      String?                                // เก็บ path รูปปก เช่น /uploads/xxx.jpg
  createdAt     DateTime @default(now())
  reviews       Review[]                               // 1 Book มีหลาย Review
}

// ตารางลูก (หลาย) — มี bookId ชี้กลับไปหาตารางแม่ (Foreign Key)
model Review {
  id      Int    @id @default(autoincrement())
  rating  Int
  content String
  bookId  Int
  book    Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  // onDelete: Cascade = ลบ Book แล้ว Review ของเล่มนั้นหายไปด้วย
}
